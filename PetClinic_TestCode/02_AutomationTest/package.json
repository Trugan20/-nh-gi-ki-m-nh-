{
  "name": "petclinic-automation-test",
  "version": "1.0.0",
  "description": "Kiểm thử tự động giao diện Pet Clinic – Mocha + Selenium WebDriver",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "mocha petclinic.spec.js --reporter spec",
    "test:edge": "cross-env BROWSER=edge mocha petclinic.spec.js --reporter spec",
    "test:chrome": "cross-env BROWSER=chrome mocha petclinic.spec.js --reporter spec",
    "test:firefox": "cross-env BROWSER=firefox mocha petclinic.spec.js --reporter spec"
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "mocha": "^10.8.2",
    "selenium-webdriver": "^4.27.0"
  }
}
