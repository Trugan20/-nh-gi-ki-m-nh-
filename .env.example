PORT=5000
NODE_ENV=development
DATABASE_URL=mysql://petclinic:petclinic@localhost:3306/petclinic

# Auto reminders
ENABLE_AUTO_REMINDER=true
REMINDER_WINDOW_MINUTES=60
REMINDER_INTERVAL_SECONDS=60

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
REMINDER_EMAIL_FROM=

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
